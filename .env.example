APP_NAME="Slowloris Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=slowloris_lab
DB_USERNAME=slowloris
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# ESP32 physical target (do not store the SoftAP password here)
TARGET_TYPE=esp32
TARGET_HOST=192.168.4.1
TARGET_PORT=80
TARGET_SCHEME=http
ESP32_HEALTH_PATH=/health
ESP32_METRICS_PATH=/metrics
ESP32_ALLOWED_HOSTS=192.168.4.1
CAPTURE_INTERFACE=wlp8s0
ESP32_SERIAL_PORT=/dev/ttyUSB0
ESP32_SERIAL_BAUD=115200
ESP32_SSID=ESP32-LAB
ESP32_BOARD="generic 30-pin"
ESP32_CHIP=ESP32-D0WD-V3
ESP32_REVISION=v3.1
ESP32_FLASH="4 MB"
ESP32_USB_BRIDGE="Silicon Labs CP2102"
ESP32_ARDUINO_BOARD_PROFILE="ESP32 Dev Module"
ESP32_ARDUINO_CORE=3.3.11
ESP32_MAC=20:50:0d:2b:39:f0
PCAP_CAPTURE_FILTER="host 192.168.4.1 and tcp port 80"
DUMPCAP_BINARY=/usr/bin/dumpcap
TSHARK_BINARY=/usr/bin/tshark
SNORT_BINARY=/usr/local/bin/snort
SNORT_CONFIG=/usr/local/etc/snort/snort.lua

# ===== UPLOAD =====
UPLOAD_MAX_SIZE_MB=256
UPLOAD_ALLOWED_ACQUISITION="pcap,pcapng,csv,json"
UPLOAD_ALLOWED_VALIDATION="json,log,csv,txt"

# ===== AI =====
AI_USE_SIMULATION=false
# Provider AI ditambahkan manual lewat dashboard: Pengaturan API.
